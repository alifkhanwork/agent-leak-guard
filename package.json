{
  "name": "@siliconvalleyglobal/agent-leak-guard",
  "version": "0.1.0",
  "description": "Inline secret leak scanner, redactor, CLI, and git hook for AI coding agents",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "agent-leak-guard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "ai",
    "claude",
    "gemini",
    "antigravity",
    "ai-agent",
    "ai-agents",
    "security",
    "secret-scanner",
    "gitleaks",
    "trufflehog",
    "credentials",
    "redact",
    "redactor",
    "guardrails",
    "leak-guard",
    "cli",
    "git-hook",
    "pre-commit",
    "developer-tools",
    "devtools",
    "llm",
    "llm-tools",
    "ai-coding-assistant",
    "cursor",
    "claude-code",
    "cline",
    "codex",
    "windsurf"
  ],
  "author": "SVG Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifkhanwork/agent-leak-guard.git"
  },
  "homepage": "https://github.com/alifkhanwork/agent-leak-guard#readme",
  "bugs": {
    "url": "https://github.com/alifkhanwork/agent-leak-guard/issues"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}

